<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Projekteringsverktyg.Server</RootNamespace>
    <AssemblyName>Projekteringsverktyg.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Databas: PostgreSQL via Entity Framework Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- Inloggning: Microsoft Entra ID (jobbkonton i Microsoft 365) -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.*" />
    <!-- Excel-export. MIT-licens, samma bibliotek som i dagens program. -->
    <PackageReference Include="ClosedXML" Version="0.*" />
    <!-- Projektfiler i Azure Blob Storage, inloggning med appens hanterade identitet -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Databasmigreringar, körs vid start i nummerordning (se Data/Migrering.cs). -->
    <EmbeddedResource Include="Data/Migreringar/*.sql" />
    <!-- Valbara värden från dagens program -->
    <EmbeddedResource Include="Data/Grundkataloger.json" />
    <!-- Grundkataloger som redigeras i appen (funktionstexter, projekteringsstöd m.m.) -->
    <EmbeddedResource Include="Data/Kataloger/*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Projekteringsverktyg.Tests" />
  </ItemGroup>

</Project>
